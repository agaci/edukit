# Chave da API Anthropic (Claude). Obtém em https://console.anthropic.com
# NUNCA partilhes esta chave nem a comites no Git. É usada apenas no servidor.
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# MongoDB Atlas — connection string completa do cluster.
# Atlas → Database → Connect → Drivers.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=edukit

# Segredo para assinar sessões (JWT). String longa e aleatória.
AUTH_SECRET=uma_string_aleatoria_bem_comprida
